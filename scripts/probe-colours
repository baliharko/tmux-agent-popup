#!/bin/sh
# Run by terminal_colours in a background window of the client's session:
# ask the terminal for its default colours (OSC 10 and 11), store them in
# @agent_popup_colours as a tmux style ("fg=#rrggbb,bg=#rrggbb", or "none" if
# nothing answered), and close this window. tmux answers from what it knows
# of the terminals showing this session, so the reply is immediate.
old="$(stty -g)"
stty raw -echo min 0 time 1
# shellcheck disable=SC1003 # \\ is the string terminator's backslash
printf '\033]10;?\033\\\033]11;?\033\\'
reply="$(dd bs=256 count=4 2>/dev/null)"
stty "$old"

# hex <10 or 11>: the colour from "ESC]11;rgb:rrrr/gggg/bbbb", as #rrggbb.
hex() {
  printf '%s' "$reply" |
    sed -n "s/.*]$1;rgb:\([0-9a-fA-F][0-9a-fA-F]\)[0-9a-fA-F]*\/\([0-9a-fA-F][0-9a-fA-F]\)[0-9a-fA-F]*\/\([0-9a-fA-F][0-9a-fA-F]\).*/#\1\2\3/p"
}
fg="$(hex 10)" bg="$(hex 11)"
if [ -n "$fg" ] && [ -n "$bg" ]; then style="fg=$fg,bg=$bg"; else style=none; fi
tmux set-option -g @agent_popup_colours "$style" \; kill-pane -t "$TMUX_PANE"
