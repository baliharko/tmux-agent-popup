#!/usr/bin/env bash
# Open an agent for the directory of a pane, in a popup attached to that
# agent's own tmux session. Creates the session the first time.
#
#   open-agent <agent> <client> <pane> [<model>]
#
# Callers pass #{client_name} and #{pane_id}. Everything else is looked up
# from those, so paths never go through shell quoting.
#
# <agent> can be one on a local model, "<agent>+local" (choose-agent), which
# starts with `ollama launch <agent> --model <model>`. Without a model it
# only reopens a session already running, and otherwise asks for one.
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=helpers.sh
. "$DIR/helpers.sh"

agent="$1" client="$2" pane="$3" model="${4:-}"

dir="$(tmux display-message -p -t "$pane" '#{pane_current_path}')"
[ -n "$dir" ] || exit 0
session="$(session_name "$agent" "$dir")"

case "$agent" in
*+local)
  if tmux has-session -t "=$session" 2>/dev/null; then
    model="$(tmux display-message -p -t "=$session:" '#{@agent_popup_model}')"
  elif [ -z "$model" ]; then
    exec "$DIR/choose-agent" "$client" "$pane" models "${agent%+local}"
  fi
  ;;
esac

# Agents ask the terminal for its colours (OSC 10 and 11) and palette (OSC
# 4) to fit their screens to it, and tmux answers from, or asks, a terminal
# showing the pane. An agent session has none: it starts with no client, and
# the popup's client is drawn by tmux itself. So the agent's pane gets the
# real terminal's colours as its style and palette, which tmux answers with
# instead; they look the same. Set in the same command as the session, so
# they're in place before the agent's first question.
colours="$(terminal_colours "$client")"
# tmux fills every cell of a pane whose style has a background, and a
# see-through terminal draws cells with a background of their own solid. So
# with @agent_popup_transparent the background is left to the terminal. The
# foreground has no such effect.
#
# tmux can't answer for a background it doesn't draw, and without an answer
# some agents fall back to plain colours (Copilot drops its whole theme). So
# answer-background, next to this file, answers in tmux's place: it reads the
# agent's output through pipe-pane, and answers questions for the background
# with the terminal's. It needs perl; without it, agents get no answer.
answer=''
if [ "$(get_option @agent_popup_transparent off)" = on ]; then
  bg="${colours##*,bg=#}"
  colours="${colours%,bg=*}"
  # As tmux answers: rgb:rrrr/gggg/bbbb, each byte twice.
  if [[ "$bg" =~ ^[0-9a-fA-F]{6}$ ]] && command -v perl >/dev/null 2>&1; then
    answer="rgb:${bg:0:2}${bg:0:2}/${bg:2:2}${bg:2:2}/${bg:4:2}${bg:4:2}"
  fi
fi
colouring=()
[ -n "$colours" ] && colouring=(\; set-option -p -t "=$session:" window-style "$colours")
i=0
for colour in $(terminal_palette); do
  colouring+=(\; set-option -p -t "=$session:" "pane-colours[$i]" "$colour")
  i=$((i + 1))
done
# pipe-pane runs its command with the shell, after expanding formats in it.
# @agent_popup_answering tells the plugin's pipe from one of your own.
answering=()
[ -n "$answer" ] && answering=(\; pipe-pane -I -O -t "=$session:"
  "exec #{q:@agent_popup_dir}/scripts/answer-background $answer" \;
  set-option -p -t "=$session:" @agent_popup_answering on)

# An agent on a local model notes its model, for titles and the menus, and
# the model becomes the first one offered next time.
noting=()
if ! tmux has-session -t "=$session" 2>/dev/null; then
  case "$agent" in
  *+local)
    cmd="$(get_option @agent_popup_local_cmd 'ollama launch') ${agent%+local} --model $model"
    noting=(\; set-option -t "=$session:" @agent_popup_model "$model" \;
      set-option -g @agent_popup_last_model "$model")
    ;;
  *) cmd="$(agent_option "$agent" cmd)" ;;
  esac
  bin="${cmd%% *}"
  case "$bin" in
  *=*) ;; # starts with VAR=value; leave it to the shell
  *)
    if ! command -v "$bin" >/dev/null 2>&1; then
      tmux display-message -c "$client" "agent-popup: $bin not found"
      exit 0
    fi
    ;;
  esac
  tmux new-session -d -s "$session" -c "$dir" "$cmd" ${colouring[@]+"${colouring[@]}"} \
    ${answering[@]+"${answering[@]}"} ${noting[@]+"${noting[@]}"}
fi

# Set on every open, so config changes reach sessions that already exist.
# The last two override global settings that would keep the popup open after
# the agent exits. set-option takes a pane target, so exact-match needs the
# trailing colon: '=name' alone is "no such session".
#
# If the agent has already exited (e.g. on a bad flag), the session is gone
# and set-option fails, or, under a global remain-on-exit, its pane is dead.
target="=$session:"
label="$(agent_label "$agent" "$model")"
if ! tmux set-option -t "$target" @agent_popup_agent "$agent" \; \
  set-option -t "$target" @agent_popup_path "$dir" \; \
  set-option -t "$target" status "$(get_option @agent_popup_status off)" \; \
  set-option -t "$target" detach-on-destroy on \; \
  set-option -w -t "$target" remain-on-exit off ${colouring[@]+"${colouring[@]}"} 2>/dev/null ||
  [ "$(tmux display-message -p -t "$target" '#{pane_dead}')" = 1 ]; then
  tmux kill-session -t "=$session" 2>/dev/null
  tmux display-message -c "$client" "agent-popup: $label exited straight away"
  exit 0
fi

# The answering pipe likewise: started for a session made without it,
# stopped once @agent_popup_transparent is off. A pipe of your own is left
# alone.
piping="$(tmux display-message -p -t "$target" '#{pane_pipe}#{@agent_popup_answering}')"
if [ -n "$answer" ] && [ "${piping:0:1}" = 0 ]; then
  tmux "${answering[@]:1}"
elif [ -z "$answer" ] && [ "$piping" = 1on ]; then
  tmux pipe-pane -t "$target" \; set-option -p -u -t "$target" @agent_popup_answering
fi

# A popup closed by a navigation key (scripts/passthrough, display-popup -C)
# reports its killed client's status, 129. That's not an error, and tmux would
# show any failure in the pane the key was pressed in.
show_agent_popup "$client" "$session" "$label" || :
