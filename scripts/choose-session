#!/usr/bin/env bash
# Open the session picker (pick-session) in a popup: every running agent, in
# any directory, including ones started by hand in ordinary panes. Pressed
# inside an agent popup, it swaps that popup for the picker.
#
#   choose-session <client> <pane>
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=helpers.sh
. "$DIR/helpers.sh"

client="$1" pane="$2"

if ! command -v fzf >/dev/null 2>&1; then
  tmux display-message -c "$client" 'agent-popup: the session picker needs fzf'
  exit 0
fi

# Inside an agent popup: close it and open the picker on the client it was
# shown on. display-popup -C closes it at once; a popup opened while another
# is still closing can come up without keyboard input.
if is_popup_client "$client"; then
  host="$(tmux display-message -p -t "$pane" '#{@agent_popup_host}')"
  if ! attached_client "$host"; then
    # Opened by an older version, or its terminal is gone: just close it.
    tmux detach-client -t "$client"
    exit 0
  fi
  tmux display-popup -C -c "$host"
  client="$host"
fi
if ! "$DIR/pick-session" --any; then
  tmux display-message -c "$client" 'agent-popup: no agents running'
  exit 0
fi

# The popup's command finds the picker through the environment, so the
# install path needs no quoting for whatever shell runs it. The picker needs
# this client to switch it to agents in ordinary panes.
# shellcheck disable=SC2016 # expanded by the popup's shell
show_popup "$client" Agents \
  -e "AGENT_POPUP_PICKER=$DIR/pick-session" -e "AGENT_POPUP_CLIENT=$client" \
  -E 'exec "$AGENT_POPUP_PICKER"' || : # see the end of open-agent
