#!/usr/bin/env bash
# Show a menu of the configured agents for the pane's directory. Agents already
# running there are marked. With ollama installed, the menu ends with "Local
# model", for an agent on a model of your own (choose-local). Inside an agent
# popup it dismisses the popup instead, like the toggle key.
#
#   choose-agent <client> <pane>
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=helpers.sh
. "$DIR/helpers.sh"

client="$1" pane="$2"

leave_agent_session "$client" "$pane" && exit 0

dir="$(tmux display-message -p -t "$pane" '#{pane_current_path}')"
[ -n "$dir" ] || exit 0
running=" $(dir_agents "$dir" | tr '\n' ' ') "

items=()
n=0
for agent in $(configured_agents); do
  n=$((n + 1))
  case "$running" in
  *" $agent "*) mark='#[fg=green]●#[default]' ;;
  *) mark=' ' ;;
  esac
  key=''
  [ "$n" -le 9 ] && key="$n"
  label="$(agent_option "$agent" label)"
  # The menu expands each command as a format and run-shell expands it again,
  # so ## reaches run-shell as #. client and pane are tty paths and %ids,
  # safe to paste.
  items+=("$mark ${label//\#/##}" "$key" \
    "run-shell -b \"##{q:@agent_popup_dir}/scripts/open-agent $agent $client $pane\"")
done
[ "$n" -gt 0 ] || exit 0

# Below a separator (an item with no name): agents on a local model, marked
# while one runs here.
if command -v ollama >/dev/null 2>&1 && [ -n "$(local_agents)" ]; then
  n=$((n + 1))
  case "$running" in
  *"+local "*) mark='#[fg=green]●#[default]' ;;
  *) mark=' ' ;;
  esac
  key=''
  [ "$n" -le 9 ] && key="$n"
  items+=('' "$mark Local model ›" "$key" \
    "run-shell -b \"##{q:@agent_popup_dir}/scripts/choose-local $client $pane\"")
fi

show_menu "$client" "$pane" Agents "${items[@]}"
