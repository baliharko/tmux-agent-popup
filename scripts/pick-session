#!/usr/bin/env bash
# The session picker, run by choose-session inside a popup. Lists every agent
# in fzf with a live preview of its screen: the plugin's own sessions, and
# agents started by hand in ordinary panes. enter opens one: a session in a
# popup of its own, a pane by switching the terminal to it. ctrl-x kills it.
#
#   pick-session                                 run the picker
#   pick-session --list                          print the rows
#   pick-session --any                           succeed if any agent runs
#   pick-session --status                        summary for the status line
#   pick-session --preview <kind> <target>       print an agent's screen
#   pick-session --kill <kind> <target> <pid>    stop an agent
#   pick-session --esc                           what esc does, for fzf
#   pick-session --open <client> <session>       swap the picker for a session
#
# Rows are "<kind>\t<target>\t<pid>\t<display>". kind "session": target is a
# session this plugin runs. kind "pane": target is a pane running an agent on
# its own, pid the agent's process. AGENT_POPUP_CLIENT, set by
# choose-session, is the client the popup is shown on.
set -u

# The preview is redrawn ten times a second, so it's handled first, without
# loading the helpers. It shows the agent's screen as the popup does, colours
# and all: -N keeps the spaces at the end of each row, which carry the
# background of an agent that paints its own (OpenCode) or fills a box
# (Copilot's text field). The blank lines below the agent's output are
# dropped and only the rows that fit are printed, so the preview shows the
# end of it (the input box) without fzf scrolling, which would put its
# position over the first row. tmux writes a colour only where it changes,
# so the codes of the rows left out go in front of the first one printed.
if [ "${1:-}" = --preview ]; then
  if [ "$2" = session ]; then target="=$3:"; else target="$3"; fi
  tmux capture-pane -eNpt "$target" | awk '
    {
      row[++n] = $0
      plain = $0
      gsub(/\033\[[0-9;:]*m/, "", plain)
      if (plain !~ /^[[:space:]]*$/) last = n
    }
    END {
      fit = ENVIRON["FZF_PREVIEW_LINES"] + 0
      first = (fit > 0 && last > fit) ? last - fit + 1 : 1
      codes = ""
      for (i = 1; i < first; i++) {
        s = row[i]
        while (match(s, /\033\[[0-9;:]*m/)) {
          codes = codes substr(s, RSTART, RLENGTH)
          s = substr(s, RSTART + RLENGTH)
        }
      }
      for (i = first; i <= last; i++) printf "%s%s\n", (i == first ? codes : ""), row[i]
    }'
  exit 0
fi

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=helpers.sh
. "$DIR/helpers.sh"

# Two modes on fzf 0.46 and newer, told apart by the prompt. nav: j/k move,
# l opens, h/q/esc close, g/G jump to the ends. search: every key types into
# the filter; esc goes back to nav and keeps it. From fzf 0.59 nav mode hides
# the input line, and / switches to search. Before, the input line always
# shows, and so / or any unbound key switches, since typing goes into it.
NAV_PROMPT='nav> ' SEARCH_PROMPT='search> '
NAV_KEYS='h,j,k,l,g,G,q,/'
NAV_HEADER='j/k: move · l: open · /: search · ctrl-x: kill · q: close'
SEARCH_HEADER='enter: open · esc: back to j/k · ctrl-x: kill'
TO_SEARCH="unbind($NAV_KEYS,change)+change-prompt($SEARCH_PROMPT)+change-header($SEARCH_HEADER)"
TO_NAV_KEYS="rebind($NAV_KEYS,change)+change-prompt($NAV_PROMPT)"
TO_NAV="$TO_NAV_KEYS+change-header($NAV_HEADER)"

# fzf_at_least <major> <minor>
fzf_at_least() {
  local v major minor
  v="$(fzf --version 2>/dev/null)"
  v="${v%% *}"
  case "$v" in
  [0-9]*.[0-9]*) ;;
  *) return 1 ;;
  esac
  major="${v%%.*}" minor="${v#*.}"
  minor="${minor%%.*}"
  [ "$major" -gt "$1" ] || { [ "$major" -eq "$1" ] && [ "$minor" -ge "$2" ]; }
}

# fzf_has_timer: whether fzf has the every(N) event. An fzf without it
# rejects the binding at startup with status 2.
fzf_has_timer() {
  fzf --filter x --bind 'every(1):ignore' </dev/null >/dev/null 2>&1
  [ "$?" -ne 2 ]
}

# screen_state <target>
# What the bottom of the agent's screen says. waiting: it shows a prompt
# that esc cancels, as agents do when they ask for approval or ask you a
# question: "esc to cancel" (Copilot, Codex). This comes first: Copilot's
# prompt replaces its "esc interrupt" line, but an agent may keep both.
# working: it offers to interrupt the agent, as agents do only while they
# work: "esc to interrupt" (Claude Code, Codex), "esc interrupt" (Copilot).
# idle otherwise. Only the bottom lines count, so the conversation itself
# can't trigger it. Screen activity won't do: Codex animates while it waits
# for input.
screen_state() {
  tmux capture-pane -pt "$1" | awk '
    NF { row[++n] = tolower($0) }
    END {
      state = "idle"
      for (i = (n > 8 ? n - 7 : 1); i <= n; i++) {
        if (row[i] ~ /esc (to )?cancel/) { state = "waiting"; break }
        if (row[i] ~ /esc (to )?interrupt/) state = "working"
      }
      print state
    }'
}

# loose_agents
# Agents running in ordinary panes, outside the plugin's sessions. A pane
# runs an agent when a process on its tty is named like one of the configured
# agents; for node, bun, deno or python, the script's name counts. One line
# per pane, fields separated by ":" (see agent_sessions): agent, pane, pid,
# session, window.pane, tty, bell (1 or 0), directory.
loose_agents() {
  {
    tmux list-panes -a -F 'T:#{pane_tty}:#{pane_id}:#{session_name}:#{window_index}.#{pane_index}:#{@agent_popup_agent}:#{pane_dead}:#{window_bell_flag}:#{pane_current_path}'
    ps -A -ww -o tty=,pid=,args=
  } | awk -v names="$(configured_agents | tr '\n' ' ')" '
    BEGIN { n = split(names, list, " "); for (i = 1; i <= n; i++) known[list[i]] = 1 }
    substr($0, 1, 2) == "T:" {
      split($0, f, ":")
      if (f[6] != "") next # a pane in one of our sessions; listed as a session
      # A dead pane (remain-on-exit) still reports the tty it had, and the
      # system may have given that tty to an unrelated program since.
      if (f[7] == "1") next
      tty = f[2]
      sub(/^\/dev\//, "", tty)
      path = $0
      for (i = 1; i <= 8; i++) sub(/^[^:]*:/, "", path)
      pane[tty] = f[3]; where[tty] = f[4] ":" f[5]; bell[tty] = f[8]; dir[tty] = path
      next
    }
    !($1 in pane) || seen[$1] { next }
    {
      exe = $3
      sub(/.*\//, "", exe)
      if (exe ~ /^(node|bun|deno|python[0-9.]*)$/)
        for (j = 4; j <= NF; j++)
          if ($j !~ /^-/) { exe = $j; sub(/.*\//, "", exe); break }
      if (!(exe in known)) next
      seen[$1] = 1
      print exe ":" pane[$1] ":" $2 ":" where[$1] ":" $1 ":" bell[$1] ":" dir[$1]
    }'
}

# claude_states
# " <tty>=<status> ..." for running Claude Code sessions, as Claude itself
# reports them through `claude agents --json`: busy, waiting (a permission
# prompt or a question) or idle. Empty without claude or jq.
claude_states() {
  local agents pids
  command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || return 0
  agents="$(claude agents --json 2>/dev/null |
    jq -r '.[] | select(.kind == "interactive") | "\(.pid) \(.status)"' 2>/dev/null)"
  [ -n "$agents" ] || return 0
  pids="$(printf '%s\n' "$agents" | cut -d' ' -f1 | paste -sd, -)"
  {
    printf '%s\n' "$agents" | sed 's/^/A /'
    ps -o pid=,tty= -p "$pids" | sed 's/^ */P /'
  } | awk '$1 == "A" { st[$2] = $3; next } $1 == "P" && ($2 in st) { printf " %s=%s", $3, st[$2] }'
  printf ' '
}

# agent_state <screen> <tty> <bell>
# working, waiting (needs you) or idle. Claude Code's own status wins where
# there is one. Otherwise what its screen says (<screen>, from
# screen_state), or waiting if it rang the bell since you last looked.
agent_state() {
  local tty="${2#/dev/}" status=''
  case "$CLAUDE_STATES" in
  *" $tty="*)
    status="${CLAUDE_STATES#* "$tty"=}"
    status="${status%% *}"
    ;;
  esac
  case "$status" in
  busy) echo working ;;
  waiting | idle) echo "$status" ;;
  *)
    if [ "$1" != idle ]; then
      echo "$1"
    elif [ "$3" = 1 ]; then
      echo waiting
    else
      echo idle
    fi
    ;;
  esac
}

# record <order> <recency> <kind> <target> <pid> <agent> <tty> <bell> <note> <directory>
# One agent's row data, with everything that takes a tmux call looked up:
# its label and what its screen says (screen_state). Fields are separated
# by \037, the directory last.
record() {
  local screen
  screen="$(screen_state "$(target_of "$3" "$4")")"
  printf '%s\037' "$1" "$2" "$3" "$4" "$5" "$(agent_option "$6" label)" "$screen" "$7" "$8" "$9"
  printf '%s\n' "${10}"
}

# gather_rows: a record per agent: the plugin's sessions, then agents in
# ordinary panes.
gather_rows() {
  local agent target pid last attached tty bell path where session place
  # read gives the last name the rest of the line, colons and all, so a
  # directory containing ":" survives.
  agent_sessions | while IFS=: read -r agent target last attached tty bell path; do
    if [ "$attached" -gt 0 ]; then where=open; else where=''; fi
    record 0 "$last" session "$target" '' "$agent" "$tty" "$bell" "$where" "$path"
  done
  loose_agents | while IFS=: read -r agent target pid session place tty bell path; do
    record 1 0 pane "$target" "$pid" "$agent" "$tty" "$bell" "$session:$place" "$path"
  done
}

# load_records [quick]
# Sets RECORDS to gather_rows' records and CLAUDE_STATES to Claude Code's own
# status, for agent_state. quick leaves out Claude Code's status, the slowest
# part. Sets globals rather than printing, since agent_state reads
# CLAUDE_STATES in this same shell.
load_records() {
  local states claude
  CLAUDE_STATES=''
  if [ "${1:-}" = quick ]; then
    RECORDS="$(gather_rows)"
  else
    # `claude agents` takes about as long as everything else put together,
    # so it runs while the rest is gathered.
    states="$(mktemp)"
    claude_states >"$states" &
    claude=$!
    RECORDS="$(gather_rows)"
    wait "$claude"
    CLAUDE_STATES="$(cat "$states")"
    rm -f "$states"
  fi
}

# list_rows [quick]: the picker's rows. The order doesn't depend on status,
# so the live reload never moves a row out from under the cursor: the
# plugin's sessions, most recently opened first, then agents in ordinary
# panes. quick (see load_records) is for the first list the picker shows;
# the full one replaces it right after.
list_rows() {
  local order recency kind target pid label screen tty bell note dir status place
  load_records "${1:-}"
  [ -n "$RECORDS" ] || return 0
  printf '%s\n' "$RECORDS" |
    while IFS=$'\037' read -r order recency kind target pid label screen tty bell note dir; do
      case "$(agent_state "$screen" "$tty" "$bell")" in
      working) status=$'\033[33m●\033[0m working' ;;
      waiting) status=$'\033[1;31m●\033[0m \033[1mwaiting\033[0m' ;;
      *) status=$'\033[32m●\033[0m idle   ' ;;
      esac
      case "$dir" in
      "$HOME" | "$HOME"/*) place="~${dir#"$HOME"}" ;;
      *) place="$dir" ;;
      esac
      # The note ("open", or where a hand-started agent runs) goes before
      # the path, which fzf cuts off first when the line is too long.
      printf '%s\t%s\t%s\t%s\t%s\t%s  %-12s \033[1m%-20s\033[0m %-10s \033[2m%s\033[0m\n' \
        "$order" "$recency" "$kind" "$target" "$pid" \
        "$status" "$label" "${dir##*/}" "$note" "$place"
    done | sort -t $'\t' -k1,1n -k2,2nr | cut -f3-
}

# target_of <kind> <target>: a tmux target for the agent's pane.
target_of() {
  if [ "$1" = session ]; then printf '=%s:' "$2"; else printf '%s' "$2"; fi
}

# status_line: how many agents are waiting, working and idle, for the tmux
# status line: a light in the picker's colours and a count per state, e.g.
# "● 1  ● 2  ● 1" in red, yellow and green. States with no agents are left
# out; with no agents at all it prints nothing, so a status-line segment
# that hides when empty goes away. Only the lights are coloured: the counts
# are in the status line's default colour. Each style is its own #[...],
# since themes put segments inside #{?...}, where a comma ends the branch.
status_line() {
  local waiting=0 working=0 idle=0 line='' screen tty bell
  load_records
  [ -n "$RECORDS" ] || return 0
  while IFS=$'\037' read -r _ _ _ _ _ _ screen tty bell _; do
    case "$(agent_state "$screen" "$tty" "$bell")" in
    waiting) waiting=$((waiting + 1)) ;;
    working) working=$((working + 1)) ;;
    *) idle=$((idle + 1)) ;;
    esac
  done <<<"$RECORDS"
  [ "$waiting" -eq 0 ] || line="$line  #[fg=red]#[bold]●#[fg=default] $waiting#[nobold]"
  [ "$working" -eq 0 ] || line="$line  #[fg=yellow]●#[fg=default] $working"
  [ "$idle" -eq 0 ] || line="$line  #[fg=green]●#[fg=default] $idle"
  printf '%s\n' "${line#  }"
}

case "${1:-}" in
--status)
  status_line
  exit 0
  ;;
--list)
  list_rows
  exit 0
  ;;
--any)
  # Whether any agent runs at all, without the statuses: for choose-session.
  [ -n "$(agent_sessions)" ] || [ -n "$(loose_agents)" ]
  exit
  ;;
--esc)
  # From search back to nav; from nav, close the picker. fzf 0.59 and later
  # (which set FZF_INPUT_STATE) hide the input line again, so a filter kept
  # from the search goes in the header. The query can hold anything, so it
  # goes last, in the colon form, which takes the rest as it is.
  if [ "${FZF_PROMPT:-}" != "$SEARCH_PROMPT" ]; then
    printf abort
  elif [ -z "${FZF_INPUT_STATE:-}" ]; then
    printf '%s' "$TO_NAV"
  elif [ -z "${FZF_QUERY:-}" ]; then
    printf 'hide-input+%s' "$TO_NAV"
  else
    printf 'hide-input+%s+change-header:filter: %s · %s' "$TO_NAV_KEYS" "$FZF_QUERY" "$NAV_HEADER"
  fi
  exit 0
  ;;
--kill)
  # A session goes entirely, agent included. tmux hangs up on the session's
  # programs, but one that ignores that (an agent in the middle of a turn,
  # say) carries on with no window; so each pane's process group also gets
  # a SIGTERM. For a pane, only the agent: the pane keeps whatever it was
  # started from, usually a shell.
  if [ "$2" = session ]; then
    pids="$(tmux list-panes -s -t "=$3" -F '#{pane_pid}')"
    tmux kill-session -t "=$3"
    for pid in $pids; do
      kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
    done
  else
    kill "$4"
    sleep 0.3 # let it exit before the list is reloaded
  fi
  exit 0
  ;;
--open)
  # Run through run-shell once a session is picked (see the end of this
  # script): close the picker's popup and open the session in its own,
  # titled with the agent's name. display-popup -C is immediate, so the new
  # popup never opens over one that's still closing.
  client="$2" session="$3"
  agent="$(tmux display-message -p -t "=$session:" '#{@agent_popup_agent}' 2>/dev/null)"
  tmux display-popup -C -c "$client"
  [ -n "$agent" ] || exit 0 # it exited in the meantime
  tmux set-option -t "=$session:" @agent_popup_host "$client"
  show_popup "$client" "$(agent_option "$agent" label)" \
    -E "exec tmux attach-session -t '=$session'" || : # see the end of open-agent
  exit 0
  ;;
esac

# fzf runs the commands below with $SHELL, so pin it for predictable parsing.
# They find this script through the environment, so its path needs no
# quoting; fzf quotes {1}, {2} and {3} itself.
export SHELL=/bin/sh FZF_DEFAULT_OPTS='' AGENT_POPUP_PICKER="$DIR/pick-session"
# shellcheck disable=SC2016 # expanded by fzf's shell
opts=(--ansi --no-sort --reverse --cycle --delimiter $'\t' --with-nth 4
  --preview '"$AGENT_POPUP_PICKER" --preview {1} {2}'
  --preview-window "up,70%,follow,border-bottom$(fzf_at_least 0 56 && echo ,noinfo)"
  --bind 'ctrl-x:execute-silent("$AGENT_POPUP_PICKER" --kill {1} {2} {3})+reload("$AGENT_POPUP_PICKER" --list)')
# The preview is as wide as the agent's popup, so it shows the agent's screen
# uncut: its only border is the line below it, fzf's scrollbar (0.36 and
# later) would take its last column, and from 0.56 fzf would put its
# position (noinfo above) over the end of the first row.
if fzf_at_least 0 36; then
  opts+=(--no-scrollbar)
fi
# Live: redraw the preview ten times a second so it follows the agent as it
# types, and reload the list (statuses) every second. Without fzf's timer,
# each finished load starts the next reload after a pause instead, which
# also redraws the preview; fzf then shows its loading spinner through the
# pause.
# shellcheck disable=SC2016 # expanded by fzf's shell
if fzf_has_timer; then
  opts+=(--bind 'every(0.1):refresh-preview'
    --bind 'every(1):reload-sync("$AGENT_POPUP_PICKER" --list)'
    --bind 'load:unbind(load)+reload-sync("$AGENT_POPUP_PICKER" --list)')
else
  opts+=(--bind 'load:reload-sync(sleep 1; "$AGENT_POPUP_PICKER" --list)+refresh-preview')
fi
# fzf's gutter, the column left of the rows, blank instead of a dark bar,
# which a see-through terminal would draw solid; and the current row
# highlighted across its whole width rather than up to its last character.
if fzf_at_least 0 66; then
  opts+=(--gutter ' ')
elif fzf_at_least 0 46; then
  opts+=(--color gutter:-1)
fi
if fzf_at_least 0 52; then
  opts+=(--highlight-line)
fi
# Nav mode shows only the rows and the keys: no input line, which comes up
# with /. In search mode the count goes at the end of the input line rather
# than on a line of its own.
if fzf_at_least 0 59; then
  # shellcheck disable=SC2016 # expanded by fzf's shell
  opts+=(--no-input --info inline-right --no-separator
    --prompt "$NAV_PROMPT" --header "$NAV_HEADER"
    --bind 'j:down,k:up,l:accept,h:abort,q:abort,g:first,G:last'
    --bind "/:show-input+$TO_SEARCH"
    --bind 'esc:transform:"$AGENT_POPUP_PICKER" --esc')
elif fzf_at_least 0 46; then
  # shellcheck disable=SC2016 # expanded by fzf's shell
  opts+=(--prompt "$NAV_PROMPT" --header "$NAV_HEADER"
    --bind 'j:down,k:up,l:accept,h:abort,q:abort,g:first,G:last'
    --bind "/:$TO_SEARCH" --bind "change:$TO_SEARCH"
    --bind 'esc:transform:"$AGENT_POPUP_PICKER" --esc')
else
  opts+=(--header 'enter: open · ctrl-x: kill')
fi
selected="$(list_rows quick | fzf "${opts[@]}")"
[ -n "$selected" ] || exit 0

kind="${selected%%$'\t'*}"
rest="${selected#*$'\t'}"
target="${rest%%$'\t'*}"
client="${AGENT_POPUP_CLIENT:-}"

if [ "$kind" = pane ]; then
  # Show the agent where it runs. The popup closes when this script exits.
  tmux switch-client -c "$client" -t "$target"
  exit 0
fi

# Open the session in a popup titled with its agent's name: tmux can't
# retitle this one. --open does it from outside this popup, which it closes
# first. The picker waits here to be closed along with it: exiting would
# close the popup too, and a popup opened while another is still closing can
# come up without keyboard input. Client names are tty paths and session
# names are [A-Za-z0-9_-], safe to paste.
tmux run-shell -b "#{q:@agent_popup_dir}/scripts/pick-session --open $client $target"
exec sleep 5
