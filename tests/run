echo "status line"
check 'the status line counts the running agents, under a green light' status_is '#[fg=green]●#[fg=default] 2'
ring_bell "$(t list-sessions -F '#S' | grep '^agent-claude-my_proj_x_nvim-')"
check '... a red light for the ones waiting for you' status_is '#[fg=red]#[bold]●#[fg=default] 1#[nobold]  #[fg=green]●#[fg=default] 1'
if command -v jq >/dev/null 2>&1; then
  claude_says "$(t list-sessions -F '#S' | grep '^agent-claude-other-')" busy
  check "... and a yellow one for those working, by Claude Code's own status" status_is '#[fg=red]#[bold]●#[fg=default] 1#[nobold]  #[fg=yellow]●#[fg=default] 1'
  rm -f "$TMP/claude-agents.json"
fi

echo "session picker"
if ! command -v fzf >/dev/null 2>&1; then
  echo "  skipped: fzf is not installed"
else
  proj_session="$(t list-sessions -F '#S' | grep '^agent-claude-my_proj_x_nvim-')"
  other_session="$(t list-sessions -F '#S' | grep '^agent-claude-other-')"
  press '\x02a'
  wait_for no_popup
  ring_bell "$proj_session"
  claude_says "$other_session" waiting
  open_picker
  check 'prefix u opens the picker' screen_has 'ctrl-x: kill'
  check 'the picker title has the chevrons' screen_has "$L Agents $R"
  check 'it lists agents from every directory' screen_has 'my proj:x.nvim'
  check '... including the other one' screen_has 'other'
  check 'an agent that rang the bell since you looked is marked waiting' \
    screen_has '● waiting  Claude Code  my proj:x.nvim'
  if command -v jq >/dev/null 2>&1; then
    check 'Claude Code saying it waits for you is marked waiting' \
      screen_has '● waiting  Claude Code  other'
    claude_says "$other_session" busy
    check '... working when it says it is busy' screen_has '● working  Claude Code  other'
    claude_says "$other_session" idle
    check '... and idle when it says so' screen_has '● idle     Claude Code  other'
  else
    echo "  skipped: Claude Code's own status needs jq"
  fi
  rm -f "$TMP/claude-agents.json"
  check 'the preview shows the agent screen' screen_has 'claude-standin-screen'
  # Colours as agents with their own theme draw them: text on a background,
  # and a row filled with a background (Copilot's text field) that carries on
  # into the next row, where tmux doesn't repeat it.
  tty="$(t display-message -p -t "=$proj_session:" '#{pane_tty}')"
  printf '\033[38;5;44;48;2;11;14;20mpainted\033[0m\n' >"$tty"
  printf '\033[48;2;49;48;54m%*scarried\033[0m\n' "$(t display-message -p -t "=$proj_session:" '#{pane_width}')" '' >"$tty"
  check "the preview keeps an agent's colours, backgrounds too" preview_matches "$proj_session" '' '48;2;11;14;20.*painted'
  check '... and a filled row to its end' preview_matches "$proj_session" '' '48;2;49;48;54m {50}'
  check '... and a colour from a row above the ones that fit' preview_matches "$proj_session" 1 '48;2;49;48;54m.*carried'
  search "'proj:x.nvim" # exact match; fuzzy would also hit the long temp paths
  sleep 0.3
  press '\r'
  check 'enter opens the chosen agent in a popup' attached_to "$proj_session"
  check '... titled with its name' screen_has "$L Claude Code $R"
  press '\x02a'
  check 'prefix a dismisses an agent opened from the picker' no_popup
  open_picker
  check 'looking at an agent clears its bell' screen_has '● idle     Claude Code  my proj:x.nvim'
  # The agent was just in its popup, which sized it. A line that ends in its
  # last column shows whole in the preview (the list's first row).
  printf '%*s\n' "$(t display-message -p -t "=$proj_session:" '#{pane_width}')" 'right-edge' \
    >"$(t display-message -p -t "=$proj_session:" '#{pane_tty}')"
  check "the preview is as wide as the agent's popup" screen_has 'right-edge'
  # More than fits: the preview shows the end, and nothing over its first row
  # (fzf's position, on fzf 0.56 and later).
  seq -f 'fill-%g' 40 >"$(t display-message -p -t "=$proj_session:" '#{pane_tty}')"
  wait_for screen_has 'fill-40'
  check '... with nothing over its first row' preview_top_row_is 'fill-'
  press '\x18'
  check 'ctrl-x kills the highlighted agent' sessions_named claude 1
  check '... and the list reloads without it' screen_has 'ctrl-x: kill'
  press '\x1b'
  check 'escape closes the picker' no_picker
  open_picker
  press '\r'
  wait_for popup_on claude
  press '\x02u'
  check 'prefix u inside an agent popup swaps it for the picker' screen_has 'ctrl-x: kill'
  check '... closing the agent popup' no_popup
  press '\x03'
  check '... and the picker takes keys' no_picker
  # An agent that ignores the hang-up tmux sends when its session is killed,
  # as one in the middle of a turn may. It writes its pid, which exec keeps.
  # shellcheck disable=SC2016 # expanded by the stand-in
  printf '%s\n' '#!/bin/sh' "trap '' HUP" 'echo $$ >"$(dirname "$0")/stubborn.pid"' 'exec sleep 600' >"$TMP/stubborn"
  chmod +x "$TMP/stubborn"
  t new-session -d -s agent-stubborn-x -c "$OTHER" "$TMP/stubborn" \; \
    set-option -t '=agent-stubborn-x:' @agent_popup_agent stubborn \; \
    set-option -t '=agent-stubborn-x:' @agent_popup_path "$OTHER"
  wait_for test -s "$TMP/stubborn.pid"
  open_picker
  search "'stubborn"
  wait_for screen_has '1/'
  press '\x18'
  check 'ctrl-x stops an agent even if it ignores the hang-up' process_gone "$(cat "$TMP/stubborn.pid")"
  press '\x03'
  wait_for no_picker
  t kill-session -t "=$(session_for claude)"
  press '\x02u'
  check 'prefix u with no agents running says so' screen_has 'no agents running'

  echo "agents outside the plugin"
  t new-window -d -t main:1 -c "$OTHER" \
    "bash -c 'echo \"Working (3s - esc to interrupt)\"; exec -a codex sleep 600'"
  loose_pane="$(t list-panes -t main:1 -F '#{pane_id}')"
  loose_pid="$(t list-panes -t main:1 -F '#{pane_pid}')"
  open_picker
  check 'an agent started by hand in a pane is listed' screen_has 'main:1.0'
  check '... as working while it offers to interrupt' screen_has '● working  Codex'
  press '\r'
  check 'enter switches the terminal to its pane' client_pane_is "$loose_pane"
  check '... and closes the picker' no_picker
  open_picker
  # Typing "main" keeps the agent's row and shows whether the reopened picker
  # gets keys at all, apart from whether ctrl-x then stops the agent.
  search 'main'
  check 'the reopened picker gets keys' screen_has '> main'
  press '\x18'
  if ! check 'ctrl-x stops that agent' process_gone "$loose_pid"; then
    echo "        the pane's process, its parent, and the picker's pid for the agent:"
    ps -o pid=,ppid=,stat=,tty=,args= -p "$loose_pid" | sed 's/^/          /'
    ps -o pid=,ppid=,stat=,args= -p "$(ps -o ppid= -p "$loose_pid" | tr -d ' ')" | sed 's/^/          /'
    echo "          pane dead: $(t display-message -p -t "$loose_pane" '#{pane_dead}' 2>&1)"
    echo "          picker row pid: $(TMUX="$SOCKET,$(t display-message -p '#{pid}'),0" \
      "$PLUGIN/scripts/pick-session" --list | awk -F'\t' '$1 == "pane" { print $3 }')"
  fi
  press '\x03' # ctrl-c: typing "main" put the picker in search mode, where esc doesn't close it
  wait_for no_picker

  echo "live updates"
  # A stand-in agent that counts ten times a second and says it's working,
  # in Copilot's words, until the test creates $TMP/livebot.ask; then it
  # clears its screen and asks for approval, as Copilot does, until the test
  # creates $TMP/livebot.done; then it clears its screen and idles. The
  # files, not timers, decide, so a slow machine can't miss a phase. exec -a
  # names the process like an agent.
  cat >"$TMP/livebot" <<'EOF'
#!/bin/sh
dir="$(dirname "$0")"
i=0 phase=working
while :; do
  i=$((i + 1))
  if [ "$phase" = working ] && [ -e "$dir/livebot.ask" ]; then
    phase=asking
    printf '\033[2J\033[H'
  fi
  if [ "$phase" = asking ] && [ -e "$dir/livebot.done" ]; then
    phase=idle
    printf '\033[2J\033[H'
  fi
  case "$phase" in
  working) echo "tick-$i ◎ Working · esc interrupt" ;;
  asking) echo "tick-$i ↑↓ to navigate · enter to select · esc to cancel" ;;
  *) echo "tick-$i" ;;
  esac
  sleep 0.1
done
EOF
  t new-window -d -t main:3 -c "$PROJ" "bash -c 'exec -a copilot sh \"\$0\"' '$TMP/livebot'"
  livebot_pane="$(t list-panes -t main:3 -F '#{pane_id}')"
  open_picker
  check 'a working agent is marked working' screen_has '● working  Copilot'
  touch "$TMP/livebot.ask"
  check '... waiting while it asks for approval' screen_has '● waiting  Copilot'
  touch "$TMP/livebot.done"
  check '... and idle once it stops, while the picker stays open' screen_has '● idle     Copilot'
  first_tick="$(max_tick)"
  check 'the preview follows the agent live' ticks_past "${first_tick:-0}"
  if fzf_has_timer; then
    check '... several times a second' preview_keeps_up
    # fzf 0.59 and later show the count, and the spinner with it, only in
    # search mode.
    if fzf_at_least 0 59; then press '/'; fi
    check 'the loading spinner only shows during a refresh' mostly_idle_spinner
    if fzf_at_least 0 59; then
      press '\x1b'
      wait_for nav_mode # two escapes at once would read as alt-esc
    fi
  fi
  press '\x1b'
  wait_for no_picker

  if fzf_at_least 0 46; then
    echo "picker keys"
    goto select-window -t main:0
    press '\x02A'
    wait_for screen_has 'Agents'
    press '1'
    wait_for popup_on claude
    press '\x02a'
    wait_for no_popup
    open_picker
    check 'the picker starts in nav mode' nav_mode
    check '... and says which keys do what' screen_has 'j/k: move'
    wait_for screen_has '● idle     Copilot'
    press 'j'
    sleep 0.3
    press 'l'
    check 'j then l opens the second agent' client_pane_is "$livebot_pane"
    goto select-window -t main:0
    open_picker
    press 'j'
    press 'k'
    sleep 0.3
    press 'l'
    check 'k moves back up' popup_on claude
    press '\x02a'
    wait_for no_popup
    open_picker
    press '/'
    check '/ switches to search' screen_has 'search>'
    press "'Copilot" # exact; fuzzy would also hit the long temp paths
    check '... which filters' screen_has '1/2'
    press '\x1b'
    check 'esc goes back to nav mode' nav_mode
    check '... and keeps the filter' rows_are 1
    if fzf_at_least 0 59; then
      check '... which the header shows' screen_has "filter: 'Copilot"
    fi
    press 'q'
    check 'q closes the picker' no_picker
    open_picker
    press 'x'
    if fzf_at_least 0 59; then
      sleep 0.3
      check 'typing any other key leaves the input line hidden' nav_mode
    else
      check 'typing any other key starts a search' screen_has 'search>'
      press '\x1b'
      wait_for screen_has 'nav>'
    fi
    press 'h'
    check 'h closes the picker' no_picker
  else
    echo "picker keys"
    echo "  skipped: needs fzf 0.46 or newer"
  fi
  t kill-window -t main:3 # livebot; the navigation tests count windows
fi

echo "navigation keys"
check 'only bound keys are wrapped' wrapped_keys 19
load_plugin
check 'loading the plugin again wraps nothing twice' wrapped_keys 19
# A wrapper bound by an older version, which passed the client the popup
# was shown on instead of the pane.
t bind-key -T prefix n if-shell -F '#{@agent_popup_agent}' \
  "run-shell -b \"#{q:@agent_popup_dir}/scripts/passthrough #{q:client_name} 'n' #{q:@agent_popup_host}\"" \
  "switch-client -T agent-popup-keys ; send-keys -K 'n'"
load_plugin
check "... and brings an older version's wrappers up to date" wraps_with_pane n
t new-window -d -t main:1 2>/dev/null # exists if the picker tests ran
t new-window -d -t main:5
goto select-window -t main:0
press '\x02A'
wait_for screen_has 'Agents'
press '1'
wait_for popup_on claude
press '\x02n'
