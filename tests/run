wait_for screen_has 'Agents'
press '6'
wait_for screen_has "$L Local model $R"
press '3'
check "ollama's own error is shown, e.g. when it isn't running" screen_has 'could not connect to ollama server'
check '... and nothing starts' no_session 'copilot+local'
mv "$TMP/ollama-list.off" "$TMP/ollama-list"
check 'no script output lands in the pane' no_view_mode

echo "menu keys"
press '\x02A'
wait_for screen_has 'Local model ›'
check 'the last item starts without the highlight' fg_is '›' default
press 'k'
