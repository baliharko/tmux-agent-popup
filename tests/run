#!/usr/bin/env bash
# End-to-end tests. Starts a private tmux server, attaches a real client on a
# pty (tests/pty_client.py), types key presses into it and checks the result.
# Agents are stand-ins (sleep, cat, false), so no agent CLI is needed.
#
#   tests/run            needs tmux 3.4+, python3 with pyte (pip install pyte)
#   PYTHON=... tests/run use another interpreter
set -u
unset TMUX # never touch the tmux server this is run from

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${PYTHON:-python3}"
"$PYTHON" -c 'import pyte' 2>/dev/null || {
  echo "tests need pyte: $PYTHON -m pip install pyte" >&2
  exit 2
}

SOCK="agent-popup-test-$$"
# Physical path: on macOS the temp dir is behind the /var -> /private/var
# symlink, and tmux reports resolved paths.
TMP="$(cd "$(mktemp -d)" && pwd -P)"
CPID=''
t() { tmux -L "$SOCK" "$@"; }
cleanup() {
  t kill-server 2>/dev/null
  rm -f "${SOCKET:-}" # kill-server leaves the socket file behind
  if [ -n "$CPID" ]; then
    kill "$CPID" 2>/dev/null
    wait "$CPID" 2>/dev/null
  fi
  # The stand-in that ignores hang-ups outlives the server if ctrl-x failed.
  [ -s "$TMP/stubborn.pid" ] && kill "$(cat "$TMP/stubborn.pid")" 2>/dev/null
  rm -rf "$TMP"
}
trap cleanup EXIT

# Install under a path that needs quoting, and use project directories whose
# names aren't valid in tmux targets.
PLUGIN="$TMP/it's #odd dir/tmux-agent-popup"
PROJ="$TMP/my proj:x.nvim" # ":" also separates fields in the scripts
OTHER="$TMP/other"
mkdir -p "$PLUGIN" "$PROJ" "$OTHER"
cp -R "$ROOT/agent-popup.tmux" "$ROOT/scripts" "$PLUGIN/"

# A stand-in for `claude agents --json`, which the picker asks for Claude
# Code's own status: it prints whatever the test put in claude-agents.json.
# First on PATH, so the tests never see the real Claude sessions running on
# the machine.
mkdir -p "$TMP/bin"
cat >"$TMP/bin/claude" <<'EOF'
#!/bin/sh
cat "$(dirname "$0")/../claude-agents.json" 2>/dev/null || echo '[]'
EOF
chmod +x "$TMP/bin/claude"
export PATH="$TMP/bin:$PATH"

# Hostile globals the plugin has to override per session.
cat >"$TMP/tmux.conf" <<'EOF'
set -g default-shell /bin/sh
set -g remain-on-exit on
set -g detach-on-destroy off
set -g @agent_popup_agents 'claude codex copilot broken shade'
set -g @agent_popup_claude_cmd  'sh -c "echo claude-standin-screen; exec sleep 600"'
set -g @agent_popup_codex_cmd   'cat'
set -g @agent_popup_copilot_cmd 'no-such-agent-binary --flag'
set -g @agent_popup_broken_cmd  'false'
set -g @agent_popup_broken_label 'Broken'
set -g @agent_popup_root_key 'M-a'
set -as terminal-features ',xterm-256color:RGB'
bind k select-window -t :=5 \; display-message 'custom k'
EOF
t -f "$TMP/tmux.conf" new-session -d -s main -x 100 -y 30 -c "$PROJ"
SOCKET="$(t display-message -p '#{socket_path}')"

# A stand-in agent that, like Codex or OpenCode, asks the terminal for its
# background colour when it starts, and like Copilot for a palette colour,
# and records the answers. The second read waits out a missing answer.
cat >"$TMP/shade" <<'EOF'
#!/bin/sh
old="$(stty -g)"
stty raw -echo min 0 time 5
printf '\033]11;?\033\\\033]4;10;?\033\\'
dd bs=256 count=2 2>/dev/null >"$(dirname "$0")/shade.reply"
stty "$old"
exec sleep 600
EOF
chmod +x "$TMP/shade"
t set -g @agent_popup_shade_cmd "$TMP/shade"
# Load the plugin the way TPM does: run the .tmux file with $TMUX pointing at
# the server.
load_plugin() { TMUX="$SOCKET,$(t display-message -p '#{pid}'),0" "$PLUGIN/agent-popup.tmux"; }
load_plugin

mkfifo "$TMP/ctl"
"$PYTHON" "$ROOT/tests/pty_client.py" "$SOCK" "$TMP/ctl" &
CPID=$!
# Hold the FIFO open read-write, so typing never blocks if the client dies.
exec 3<>"$TMP/ctl"

# Powerline thin chevrons around menu and popup titles (U+E0B3, U+E0B1).
# printf rather than $'\u...': macOS ships bash 3.2.
L="$(printf '\356\202\263')" R="$(printf '\356\202\261')"

failures=0
pass() { printf '  ok    %s\n' "$1"; }
fail() {
  printf '  FAIL  %s\n' "$1"
  failures=$((failures + 1))
  # The last screen the check looked at, if it looked at one, and who's where.
  [ -f "$TMP/snap" ] && sed 's/^/        | /' "$TMP/snap"
  t list-clients -F '        client #{client_name} -> #{client_session} (keys: #{client_key_table})'
  t show-messages 2>/dev/null | tail -n 3 | sed 's/^/        message /'
}

# wait_up_to <seconds> <command...>: poll until the command succeeds.
wait_up_to() {
  local tries=$(($1 * 10))
  shift
  for _ in $(seq "$tries"); do
    "$@" 2>/dev/null && return 0
    sleep 0.1
  done
  return 1
}
# wait_for <command...>: up to 5 seconds.
wait_for() { wait_up_to 5 "$@"; }
# check <description> <command...>
# A client that exits was detached, which ends the run: nothing after it can
# pass.
check() {
  local desc="$1"
  shift
  local ok=0
  if wait_for "$@"; then pass "$desc"; else fail "$desc"; ok=1; fi
  if ! kill -0 "$CPID" 2>/dev/null; then
    echo "the test client exited (detached?); stopping"
    exit 1
  fi
  return "$ok"
}
# settle: for checks that something did NOT happen.
settle() { sleep 0.7; }
# goto <tmux command...>: switch the terminal's session or window from here,
# then give the client a moment. tmux 3.4 can drop a key that arrives while
# the client is still switching; a person can't type that fast after one.
goto() {
  t "$@"
  sleep 0.3
}

press() { printf '%s\n' "$1" >&3; }
# open_picker: prefix u, and wait for the picker's rows. A key pressed while
# the previous popup is still closing goes to that popup and is lost; a
# person would press it again, so the test does too, but only when no picker
# came up at all (a second press would type into an open one).
open_picker() {
  press '\x02u'
  wait_up_to 2 screen_has 'ctrl-x: kill' || press '\x02u'
  wait_for screen_has '● '
}
snap() {
  rm -f "$TMP/snap"
  printf '#snap %s\n' "$TMP/snap" >&3
  wait_for test -f "$TMP/snap"
}
screen_has() { snap && grep -qF -- "$1" "$TMP/snap"; }

session_for() { t list-sessions -F '#S' | grep "^agent-$1-" | head -n 1; }
has_session() { [ -n "$(session_for "$1")" ]; }
no_session() { ! has_session "$1"; }
popup_on() { t list-clients -F '#{client_session}' | grep -q "^agent-$1-"; }
attached_to() { t list-clients -F '#{client_session}' | grep -qx "$1"; }
# no_picker: the picker is off the screen and its process has exited. fzf
# blanks the screen before the picker's script finishes, and a popup opened
# while the previous one is still closing can come up without keyboard input,
# so also give tmux a moment to take the old popup down.
no_picker() {
  snap && ! grep -qF 'ctrl-x: kill' "$TMP/snap" || return 1
  ! pgrep -f "$PLUGIN/scripts/pick-session" >/dev/null || return 1
  sleep 0.2
}
no_popup() { ! t list-clients -F '#{client_session}' | grep -q '^agent-'; }
main_attached() { t list-clients -F '#{client_session}' | grep -qx main; }
sessions_named() { [ "$(t list-sessions -F '#S' | grep -c "^agent-$1-")" -eq "$2" ]; }
# opt_is <agent> <option> <value> [-w]
opt_is() { [ "$(t show-options ${4:+"$4"} -t "=$(session_for "$1"):" "$2")" = "$2 $3" ]; }
# client_pane_is <pane>: the terminal is showing <pane>. Read from list-clients,
# where #{pane_id} is each client's own pane; display-message -c would give
# the pane of whichever session was active last.
client_pane_is() { [ "$(t list-clients -F '#{pane_id}' | head -n 1)" = "$1" ]; }
# The highest tick-N on screen: livebot's counter, as the preview shows it.
max_tick() { snap && grep -oE 'tick-[0-9]+' "$TMP/snap" | sed 's/tick-//' | sort -n | tail -n 1; }
ticks_past() { [ "$(max_tick)" -gt "$1" ]; }
# preview_keeps_up: five times in a row, the preview moves on within a quarter
# of a second. A once-a-second preview rarely manages that.
preview_keeps_up() {
  local before after
  for _ in 1 2 3 4 5; do
    before="$(max_tick)"
    sleep 0.25
    after="$(max_tick)"
    [ "${after:-0}" -gt "${before:-0}" ] || return 1
  done
}
# fzf_at_least <major> <minor>, as in pick-session.
fzf_at_least() {
  local v
  v="$(fzf --version 2>/dev/null)"
  v="${v%% *}"
  [ "${v%%.*}" -gt "$1" ] || { [ "${v%%.*}" -eq "$1" ] && [ "$(printf '%s' "${v#*.}" | cut -d. -f1)" -ge "$2" ]; }
}
# fzf's loading spinner (one of its braille frames) on the count line.
spinner_on() { grep -E '[0-9]+/[0-9]+' "$TMP/snap" | grep -qE '⠋|⠙|⠹|⠸|⠼|⠴|⠦|⠧|⠇|⠏'; }
# mostly_idle_spinner: the spinner is off in at least half of 6 screens taken
# a quarter second apart, i.e. it shows while a refresh runs, not all the
# time as with a pause inside the reload (about 90% on).
mostly_idle_spinner() {
  local off=0
  for _ in 1 2 3 4 5 6; do
    snap && ! spinner_on && off=$((off + 1))
    sleep 0.25
  done
  [ "$off" -ge 3 ]
}
# fzf_has_timer, as in pick-session.
fzf_has_timer() {
  fzf --filter x --bind 'every(1):ignore' </dev/null >/dev/null 2>&1
  [ "$?" -ne 2 ]
}
# claude_says <session> <status>: Claude Code in <session> reports <status>.
claude_says() {
  printf '[{"pid": %s, "kind": "interactive", "status": "%s"}]\n' \
    "$(t display-message -p -t "=$1:" '#{pane_pid}')" "$2" >"$TMP/claude-agents.json"
}
# preview_of <session> [rows]: what the picker's preview shows for it, in a
# preview <rows> high (all of it if not given).
preview_of() {
  FZF_PREVIEW_LINES="${2:-}" TMUX="$SOCKET,$(t display-message -p '#{pid}'),0" \
    "$PLUGIN/scripts/pick-session" --preview session "$1"
}
# preview_top_row_is <text>: the picker's preview starts with <text>, and
# that's all its first row shows. The row below the picker's title.
preview_top_row_is() {
  snap && awk -F'│' -v t="$1" '
    /Agents/ { getline; row = $2; sub(/ +$/, "", row); ok = index(row, t) == 1 && row !~ /[0-9]+\/[0-9]+$/; exit }
    END { exit !ok }' "$TMP/snap"
}
# preview_matches <session> <rows> <regex>
preview_matches() { preview_of "$1" "$2" | grep -qE -- "$3"; }
# ring_bell <session>: the agent in <session> rings the terminal bell.
ring_bell() { printf '\a' >"$(t display-message -p -t "=$1:" '#{pane_tty}')"; }
colours_cached() { [ "$(t show-options -gv @agent_popup_colours)" = "$1" ]; }
palette_cached() { [ "$(t show-options -gv @agent_popup_palette)" = "$1" ]; }
# tmux_at_least <major> <minor>: prints "yes" if the server's tmux is that
# version or newer ("3.4", "3.7c", "next-3.8").
tmux_at_least() {
  t display-message -p '#{version}' | sed 's/[^0-9.]//g' |
    awk -F. -v M="$1" -v m="$2" '$1 > M || ($1 == M && $2 + 0 >= m) { print "yes" }'
}
windows_in_main() { [ "$(t list-windows -t main | wc -l | tr -d ' ')" = "$1" ]; }
process_gone() { ! kill -0 "$1" 2>/dev/null; }
window_is() { [ "$(t display-message -p -t main: '#{window_index}')" = "$1" ]; }
wrapped_keys() { [ "$(t list-keys -T prefix | grep -c 'scripts/passthrough')" -eq "$1" ]; }
in_dir() { [ "$(t display-message -p -t main: '#{pane_current_path}')" = "$1" ]; }
# Script failures and output show up in view mode, in whichever pane the key
# was pressed in, not necessarily the current one.
no_view_mode() { ! t list-panes -a -F '#{pane_in_mode}' | grep -q 1; }

wait_for main_attached || {
  echo "client failed to attach" >&2
  exit 1
}

echo "first use"
press '\x02a'
check 'prefix a with nothing running opens the menu' screen_has 'Agents'
check 'the menu title has the chevrons' screen_has "$L Agents $R"
check 'the menu lists every agent' screen_has 'Broken'
press '1'
check 'choosing Claude Code opens its popup' popup_on claude
check 'the popup title has the chevrons' screen_has "$L Claude Code $R"
check 'the session is named after the directory' has_session 'claude-my_proj_x_nvim'
check 'status bar is off in the session' opt_is claude status off
check 'detach-on-destroy is forced on' opt_is claude detach-on-destroy on
check 'remain-on-exit is forced off' opt_is claude remain-on-exit off -w

echo "terminal colours"
check "the terminal's colours are learned once and cached" colours_cached 'fg=#dcd7ba,bg=#1f1f28'
# tmux passes palette questions on to the terminal from 3.6.
if [ "$(tmux_at_least 3 6)" ]; then
  check '... with its palette' palette_cached '#102030 #112131 #122232 #132333 #142434 #152535 #162636 #172737 #182838 #192939 #1a2a3a #1b2b3b #1c2c3c #1d2d3d #1e2e3e #1f2f3f'
else
  check '... without a palette on this tmux' palette_cached none
fi
check '... by a window that closes itself' windows_in_main 1
press '\x02a' # put away Claude Code's popup from above
wait_for no_popup
press '\x02A'
wait_for screen_has 'Agents'
press '5'
check 'an agent asking for the background gets the real terminal colour' \
  grep -q 'rgb:1f1f/1f1f/2828' "$TMP/shade.reply"
if [ "$(tmux_at_least 3 6)" ]; then
  check '... and for a palette colour, the real one' grep -q ']4;10;rgb:1a1a/2a2a/3a3a' "$TMP/shade.reply"
fi
press '\x02a'
wait_for no_popup
t kill-session -t "=$(session_for shade)"
press '\x02a' # and bring Claude Code back for the next section
wait_for popup_on claude

echo "toggle"
press '\x02a'
check 'prefix a inside the popup dismisses it' no_popup
check 'the agent keeps running' has_session claude
press '\x02a'
check 'prefix a reopens the agent without the menu' popup_on claude
check '... in the same session' sessions_named claude 1
press '\x02d'
check 'prefix d dismisses it too' no_popup

echo "several agents"
press '\x02A'
check 'prefix A opens the menu' screen_has 'Agents'
check 'running agents are marked' screen_has '● Claude Code'
press '2'
check 'choosing Codex opens it' popup_on codex
press '\x02a'
wait_for no_popup
press '\x02a'
check 'prefix a reopens the most recently used agent' popup_on codex
press '\x04'
check 'quitting the agent closes the popup' no_popup
check '... and ends its session' no_session codex
press '\x02a'
check 'prefix a falls back to the remaining agent' popup_on claude
press '\x02A'
check 'prefix A inside the popup dismisses it' no_popup

echo "root key"
press '\x1ba'
check 'M-a opens the popup' popup_on claude
press '\x1ba'
check 'M-a inside the popup dismisses it' no_popup

echo "failures"
press '\x02A'
wait_for screen_has 'Agents'
press '3'
check 'a missing agent binary is reported' screen_has 'no-such-agent-binary not found'
check '... and creates no session' no_session copilot
press '\x02A'
wait_for screen_has 'Agents'
press '4'
check 'an agent that exits at once is reported' screen_has 'Broken exited straight away'
check '... and leaves no dead session behind' no_session broken
t set-option -g remain-on-exit off
press '\x02A'
wait_for screen_has 'Agents'
press '4'
check '... also without a global remain-on-exit' screen_has 'Broken exited straight away'
check '... again leaving no session' no_session broken
t set-option -g remain-on-exit on
check 'no script output lands in the pane' no_view_mode

echo "agent session outside a popup"
goto switch-client -c "$(t list-clients -F '#{client_name}' | head -n 1)" -t "=$(session_for claude):"
press '\x02a'
check 'prefix a says so instead of detaching the terminal' screen_has 'already in an agent session'
check 'the terminal stays attached' popup_on claude
press '\x02('
check 'prefix ( there still switches back, as normal' main_attached

echo "another directory"
t send-keys -t main: "cd '$OTHER'" Enter
wait_for in_dir "$OTHER"
press '\x02a'
check 'prefix a in a new directory opens the menu' screen_has 'Agents'
press '\x1b'
settle
check 'escape closes it without starting anything' sessions_named claude 1
press '\x02a'
wait_for screen_has 'Agents'
press '1'
check 'the new directory gets its own session' sessions_named claude 2
# Wait for its popup to attach too: keys typed while it starts are replayed
# into it afterwards, like typeahead.
wait_for popup_on claude

echo "session picker"
if ! command -v fzf >/dev/null 2>&1; then
  echo "  skipped: fzf is not installed"
else
  proj_session="$(t list-sessions -F '#S' | grep '^agent-claude-my_proj_x_nvim-')"
  other_session="$(t list-sessions -F '#S' | grep '^agent-claude-other-')"
  press '\x02a'
  wait_for no_popup
  ring_bell "$proj_session"
  claude_says "$other_session" waiting
  open_picker
  check 'prefix u opens the picker' screen_has 'ctrl-x: kill'
  check 'the picker title has the chevrons' screen_has "$L Agents $R"
  check 'it lists agents from every directory' screen_has 'my proj:x.nvim'
  check '... including the other one' screen_has 'other'
  check 'an agent that rang the bell since you looked is marked waiting' \
    screen_has '● waiting  Claude Code  my proj:x.nvim'
  if command -v jq >/dev/null 2>&1; then
    check 'Claude Code saying it waits for you is marked waiting' \
      screen_has '● waiting  Claude Code  other'
    claude_says "$other_session" busy
    check '... working when it says it is busy' screen_has '● working  Claude Code  other'
    claude_says "$other_session" idle
    check '... and idle when it says so' screen_has '● idle     Claude Code  other'
  else
    echo "  skipped: Claude Code's own status needs jq"
  fi
  rm -f "$TMP/claude-agents.json"
  check 'the preview shows the agent screen' screen_has 'claude-standin-screen'
  # Colours as agents with their own theme draw them: text on a background,
  # and a row filled with a background (Copilot's text field) that carries on
  # into the next row, where tmux doesn't repeat it.
  tty="$(t display-message -p -t "=$proj_session:" '#{pane_tty}')"
  printf '\033[38;5;44;48;2;11;14;20mpainted\033[0m\n' >"$tty"
  printf '\033[48;2;49;48;54m%*scarried\033[0m\n' "$(t display-message -p -t "=$proj_session:" '#{pane_width}')" '' >"$tty"
  check "the preview keeps an agent's colours, backgrounds too" preview_matches "$proj_session" '' '48;2;11;14;20.*painted'
  check '... and a filled row to its end' preview_matches "$proj_session" '' '48;2;49;48;54m {50}'
  check '... and a colour from a row above the ones that fit' preview_matches "$proj_session" 1 '48;2;49;48;54m.*carried'
  press "'proj:x.nvim" # exact match; fuzzy would also hit the long temp paths
  sleep 0.3
  press '\r'
  check 'enter opens the chosen agent in the popup' attached_to "$proj_session"
  press '\x02a'
  check 'prefix a dismisses an agent opened from the picker' no_popup
  open_picker
  check 'looking at an agent clears its bell' screen_has '● idle     Claude Code  my proj:x.nvim'
  # The agent was just in its popup, which sized it. A line that ends in its
  # last column shows whole in the preview (the list's first row).
  printf '%*s\n' "$(t display-message -p -t "=$proj_session:" '#{pane_width}')" 'right-edge' \
    >"$(t display-message -p -t "=$proj_session:" '#{pane_tty}')"
  check "the preview is as wide as the agent's popup" screen_has 'right-edge'
  # More than fits: the preview shows the end, and nothing over its first row
  # (fzf's position, on fzf 0.56 and later).
  seq -f 'fill-%g' 40 >"$(t display-message -p -t "=$proj_session:" '#{pane_tty}')"
  wait_for screen_has 'fill-40'
  check '... with nothing over its first row' preview_top_row_is 'fill-'
  press '\x18'
  check 'ctrl-x kills the highlighted agent' sessions_named claude 1
  check '... and the list reloads without it' screen_has 'ctrl-x: kill'
  press '\x1b'
  check 'escape closes the picker' no_picker
  open_picker
  press '\r'
  wait_for popup_on claude
  press '\x02u'
  check 'prefix u inside an agent popup swaps it for the picker' screen_has 'ctrl-x: kill'
  check '... closing the agent popup' no_popup
  press '\x03'
  check '... and the picker takes keys' no_picker
  # An agent that ignores the hang-up tmux sends when its session is killed,
  # as one in the middle of a turn may. It writes its pid, which exec keeps.
  # shellcheck disable=SC2016 # expanded by the stand-in
  printf '%s\n' '#!/bin/sh' "trap '' HUP" 'echo $$ >"$(dirname "$0")/stubborn.pid"' 'exec sleep 600' >"$TMP/stubborn"
  chmod +x "$TMP/stubborn"
  t new-session -d -s agent-stubborn-x -c "$OTHER" "$TMP/stubborn" \; \
    set-option -t '=agent-stubborn-x:' @agent_popup_agent stubborn \; \
    set-option -t '=agent-stubborn-x:' @agent_popup_path "$OTHER"
  wait_for test -s "$TMP/stubborn.pid"
  open_picker
  press "'stubborn"
  wait_for screen_has '1/'
  press '\x18'
  check 'ctrl-x stops an agent even if it ignores the hang-up' process_gone "$(cat "$TMP/stubborn.pid")"
  press '\x03'
  wait_for no_picker
  t kill-session -t "=$(session_for claude)"
  press '\x02u'
  check 'prefix u with no agents running says so' screen_has 'no agents running'

  echo "agents outside the plugin"
  t new-window -d -t main:1 -c "$OTHER" \
    "bash -c 'echo \"Working (3s - esc to interrupt)\"; exec -a codex sleep 600'"
  loose_pane="$(t list-panes -t main:1 -F '#{pane_id}')"
  loose_pid="$(t list-panes -t main:1 -F '#{pane_pid}')"
  open_picker
  check 'an agent started by hand in a pane is listed' screen_has 'main:1.0'
  check '... as working while it offers to interrupt' screen_has '● working  Codex'
  press '\r'
  check 'enter switches the terminal to its pane' client_pane_is "$loose_pane"
  check '... and closes the picker' no_picker
  open_picker
  # Typing "main" keeps the agent's row and shows whether the reopened picker
  # gets keys at all, apart from whether ctrl-x then stops the agent.
  press 'main'
  check 'the reopened picker gets keys' screen_has '> main'
  press '\x18'
  if ! check 'ctrl-x stops that agent' process_gone "$loose_pid"; then
    echo "        the pane's process, its parent, and the picker's pid for the agent:"
    ps -o pid=,ppid=,stat=,tty=,args= -p "$loose_pid" | sed 's/^/          /'
    ps -o pid=,ppid=,stat=,args= -p "$(ps -o ppid= -p "$loose_pid" | tr -d ' ')" | sed 's/^/          /'
    echo "          pane dead: $(t display-message -p -t "$loose_pane" '#{pane_dead}' 2>&1)"
    echo "          picker row pid: $(TMUX="$SOCKET,$(t display-message -p '#{pid}'),0" \
      "$PLUGIN/scripts/pick-session" --list | awk -F'\t' '$1 == "pane" { print $3 }')"
  fi
  press '\x03' # ctrl-c: typing "main" put the picker in search mode, where esc doesn't close it
  wait_for no_picker

  echo "live updates"
  # A stand-in agent that counts ten times a second and says it's working,
  # in Copilot's words, until the test creates $TMP/livebot.done; then it
  # clears its screen and idles. The file, not a timer, decides, so a slow machine can't miss the
  # working phase. exec -a names the process like an agent.
  cat >"$TMP/livebot" <<'EOF'
#!/bin/sh
done_file="$(dirname "$0")/livebot.done"
i=0 idle=''
while :; do
  i=$((i + 1))
  if [ -z "$idle" ] && [ -e "$done_file" ]; then
    idle=1
    printf '\033[2J\033[H'
  fi
  if [ -z "$idle" ]; then echo "tick-$i ◎ Working · esc interrupt"; else echo "tick-$i"; fi
  sleep 0.1
done
EOF
  t new-window -d -t main:3 -c "$PROJ" "bash -c 'exec -a copilot sh \"\$0\"' '$TMP/livebot'"
  livebot_pane="$(t list-panes -t main:3 -F '#{pane_id}')"
  open_picker
  check 'a working agent is marked working' screen_has '● working  Copilot'
  touch "$TMP/livebot.done"
  check '... and idle once it stops, while the picker stays open' screen_has '● idle     Copilot'
  first_tick="$(max_tick)"
  check 'the preview follows the agent live' ticks_past "${first_tick:-0}"
  if fzf_has_timer; then
    check '... several times a second' preview_keeps_up
    check 'the loading spinner only shows during a refresh' mostly_idle_spinner
  fi
  press '\x1b'
  wait_for no_picker

  if fzf_at_least 0 46; then
    echo "picker keys"
    goto select-window -t main:0
    press '\x02A'
    wait_for screen_has 'Agents'
    press '1'
    wait_for popup_on claude
    press '\x02a'
    wait_for no_popup
    open_picker
    check 'the picker starts in nav mode' screen_has 'nav>'
    check '... and says which keys do what' screen_has 'j/k: move'
    wait_for screen_has '● idle     Copilot'
    press 'j'
    sleep 0.3
    press 'l'
    check 'j then l opens the second agent' client_pane_is "$livebot_pane"
    goto select-window -t main:0
    open_picker
    press 'j'
    press 'k'
    sleep 0.3
    press 'l'
    check 'k moves back up' popup_on claude
    press '\x02a'
    wait_for no_popup
    open_picker
    press '/'
    check '/ switches to search' screen_has 'search>'
    press "'Copilot" # exact; fuzzy would also hit the long temp paths
    check '... which filters' screen_has '1/2'
    press '\x1b'
    check 'esc goes back to nav mode' screen_has 'nav>'
    check '... and keeps the filter' screen_has '1/2'
    press 'q'
    check 'q closes the picker' no_picker
    open_picker
    press 'x'
    check 'typing any other key starts a search' screen_has 'search>'
    press '\x1b'
    wait_for screen_has 'nav>'
    press 'h'
    check 'h closes the picker' no_picker
  else
    echo "picker keys"
    echo "  skipped: needs fzf 0.46 or newer"
  fi
  t kill-window -t main:3 # livebot; the navigation tests count windows
fi

echo "navigation keys"
check 'only bound keys are wrapped' wrapped_keys 18
load_plugin
check 'loading the plugin again wraps nothing twice' wrapped_keys 18
t new-window -d -t main:1 2>/dev/null # exists if the picker tests ran
t new-window -d -t main:5
goto select-window -t main:0
press '\x02A'
wait_for screen_has 'Agents'
press '1'
wait_for popup_on claude
press '\x02n'
check 'prefix n inside the popup closes it' no_popup
check '... and switches the window underneath' window_is 1
press '\x02n'
check 'prefix n elsewhere works as before' window_is 5
goto select-window -t main:0
press '\x02a'
wait_for popup_on claude
press '\x02k'
check 'a custom binding passes through too' no_popup
check '... with all of its commands' window_is 5
goto select-window -t main:0
press '\x02a'
wait_for popup_on claude
press '\x025'
check 'prefix 5 selects window 5 underneath' window_is 5
check '... and the agent keeps running' has_session claude
settle
check 'closing popups this way reports no errors' no_view_mode

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed"
  exit 1
fi
echo "all passed"
