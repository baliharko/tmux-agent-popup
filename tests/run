goto select-window -t main:0
press '\x02a'
wait_for popup_on claude
press '\x02c'
check 'prefix c inside the popup closes it' no_popup
check '... and opens a window underneath' window_is 2
check '... not in the agent session' windows_in_session claude 1
settle
check 'closing popups this way reports no errors' no_view_mode

echo "two terminals"
# A second terminal on the same session, as Ghostty's quick terminal can be.
# Each shows the agent in a popup of its own, and keys pressed in a popup act
# on that terminal, not on whichever opened the agent last.
mkfifo "$TMP/ctl2"
"$PYTHON" "$ROOT/tests/pty_client.py" "$SOCK" "$TMP/ctl2" &
CPID2=$!
exec 4<>"$TMP/ctl2"
press2() { printf '%s\n' "$1" >&4; }
snap2() {
  rm -f "$TMP/snap2"
  printf '#snap %s\n' "$TMP/snap2" >&4
  wait_for test -f "$TMP/snap2"
}
screen2_has() { snap2 && grep -qF -- "$1" "$TMP/snap2"; }
screen2_lacks() { snap2 && ! grep -qF -- "$1" "$TMP/snap2"; }
terminals_on_main() { [ "$(t list-clients -F '#{client_session}' | grep -cx main)" -eq "$1" ]; }
popups_on() { [ "$(t list-clients -F '#{client_session}' | grep -c "^agent-$1-")" -eq "$2" ]; }
wait_for terminals_on_main 2
goto select-window -t main:0
press '\x02a'
wait_for popup_on claude
press2 '\x02a'
check 'a second terminal shows the agent in a popup of its own' popups_on claude 2
press '\x02n'
check 'prefix n closes the popup of the terminal it was pressed in' screen_lacks "$L Claude Code $R"
check '... not the other one' screen2_has "$L Claude Code $R"
if command -v fzf >/dev/null 2>&1; then
  for c in $(t list-clients -F '#{client_name}'); do t display-popup -C -c "$c" 2>/dev/null; done
  wait_for popups_on claude 0
  goto select-window -t main:0 # prefix n moved on from it
  settle
  press2 '\x02a'
  wait_for popups_on claude 1
  press '\x02a' # the first terminal opens the agent last
  wait_for popups_on claude 2
  press2 '\x02u'
  check 'prefix u opens the picker on the terminal it was pressed in' screen2_has 'ctrl-x: kill'
  check '... leaving the other its popup' screen_has "$L Claude Code $R"
  press2 '\x03'
  wait_for screen2_lacks 'ctrl-x: kill'
fi

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed"
  exit 1
fi
echo "all passed"
